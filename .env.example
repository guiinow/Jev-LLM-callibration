# Required for real runs (configs/final.yaml, full_local.yaml, pilot.yaml). Never commit .env.
TYPESAFE_API_KEY=
# Fallback only; the configs pin the Jev model explicitly.
TYPESAFE_DEFAULT_MODEL=jev-1.14.0
# The configs point the LLM at the local Ollama server (no key needed). These are only used
# by configs without an `llm:` section.
OPENAI_API_KEY=
OPENAI_BASE_URL=http://localhost:11434/v1
LLM_MODEL=ministral-3-14b-ctx8k
